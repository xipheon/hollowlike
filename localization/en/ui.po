# Hollowlike: interface text, English.
# One file per language and feature: localization/<language>/<feature>.po.
# Every key starts UI_; msgstr is the text shown. Keep {named} placeholders as
# they are (move them anywhere in the sentence). See localization/README.md.
msgid ""
msgstr ""
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#. Main menu: the game's title.
msgid "UI_TITLE"
msgstr "HOLLOWLIKE"

#. Main menu buttons.
msgid "UI_MENU_START"
msgstr "New Game"

msgid "UI_MENU_LEVEL_SELECT"
msgstr "Test Rooms"

#. {language}: the language in use, e.g. "English". Pressing it switches to the next one.
msgid "UI_MENU_LANGUAGE"
msgstr "Language: {language}"

msgid "UI_MENU_QUIT"
msgstr "Quit"

#. Shown along the bottom of the main menu.
msgid "UI_MENU_HINT"
msgstr "Arrows / Enter or d-pad / A to choose   ·   Esc / Start pauses in game"

#. Level Select (a debug menu): its title and the rooms it lists.
msgid "UI_LEVEL_SELECT_TITLE"
msgstr "LEVEL SELECT"

msgid "UI_LEVEL_FIRST_TEST_ROOM"
msgstr "First Test Room"

msgid "UI_LEVEL_BOSS"
msgstr "Boss"

msgid "UI_LEVEL_CLIMB_DASH"
msgstr "Climb (with Dash)"

msgid "UI_LEVEL_AERIE_DASH"
msgstr "Aerie (with Dash)"

#. Back to the previous menu (Level Select, Skin).
msgid "UI_BACK"
msgstr "Back"

#. Pause menu.
msgid "UI_PAUSE_TITLE"
msgstr "PAUSED"

msgid "UI_PAUSE_RESUME"
msgstr "Resume"

msgid "UI_PAUSE_SKIN"
msgstr "Skin"

msgid "UI_PAUSE_QUIT_TO_MENU"
msgstr "Quit to Menu"

msgid "UI_PAUSE_QUIT_GAME"
msgstr "Quit Game"

#. The controls, listed in the pause menu. Keep the line breaks.
msgid "UI_PAUSE_CONTROLS"
msgstr ""
"Move: A/D or arrows · left stick / d-pad\n"
"Jump: Space/Z · A   (hold = higher)\n"
"Attack: J/X · X   (hold Up / Down-in-air to aim)\n"
"Sprint: Shift · LT   (uses stamina)\n"
"Dash: K/C · RB/B   (uses stamina)\n"
"Pause: Esc/P · Start      Restart: R"

#. Skin menu: its title and the player's outfits.
msgid "UI_SKIN_TITLE"
msgstr "SKIN"

msgid "UI_SKIN_CLASSIC"
msgstr "Brown Jacket"

msgid "UI_SKIN_PINK"
msgstr "Pink Jacket"

#. HUD: the abilities you have. {list}: their names, joined by UI_LIST_SEPARATOR.
msgid "UI_HUD_ABILITIES"
msgstr "Abilities: {list}"

#. HUD: in place of the list when you have no abilities.
msgid "UI_HUD_NO_ABILITIES"
msgstr "none"

#. Between names in a list.
msgid "UI_LIST_SEPARATOR"
msgstr ", "

#. On screen when you get an ability. {ability}: its name.
msgid "UI_HUD_UNLOCKED"
msgstr "Unlocked: {ability}"

#. On screen when a boss is beaten. {boss}: its name. What it drops is picked up after.
msgid "UI_HUD_BOSS_FALLS"
msgstr "{boss} FALLS"

#. Ability names.
msgid "UI_ABILITY_DOUBLE_JUMP"
msgstr "Double Jump"

msgid "UI_ABILITY_SPRINT"
msgstr "Sprint"

msgid "UI_ABILITY_DASH"
msgstr "Dash"

msgid "UI_ABILITY_WALL_JUMP"
msgstr "Wall Jump"

#. Boss names, shown as a title when the fight starts and over its health bar.
msgid "UI_BOSS_WARDEN"
msgstr "THE WARDEN"

msgid "UI_BOSS_HARRIER"
msgstr "SIN HAWK"

#. Death screen: its title and buttons.
msgid "UI_DEATH_TITLE"
msgstr "YOU DIED"

msgid "UI_DEATH_RESPAWN"
msgstr "Respawn"

msgid "UI_DEATH_QUIT_TO_MENU"
msgstr "Quit to Main Menu"

#. Death screen: what dealt the final blow, under YOU DIED. One sentence each.
msgid "UI_DEATH_BY_SPIKES"
msgstr "Impaled on the spikes"

msgid "UI_DEATH_BY_ACID"
msgstr "Dissolved in the sewer water"

msgid "UI_DEATH_BY_CRAWLER"
msgstr "Smothered by a crawler"

#. Walking into a thug (not its punch).
msgid "UI_DEATH_BY_THUG"
msgstr "Shoved down by a thug"

msgid "UI_DEATH_BY_THUG_PUNCH"
msgstr "Knocked out by a thug's punch"

#. The Warden's body: walking into it, or its charge.
msgid "UI_DEATH_BY_WARDEN"
msgstr "Trampled by The Warden"

msgid "UI_DEATH_BY_WARDEN_SHOCKWAVE"
msgstr "Flattened by The Warden's shockwave"

#. The Sin Hawk's body: walking into it, or its swoop.
msgid "UI_DEATH_BY_HARRIER"
msgstr "Torn down by the Sin Hawk"

msgid "UI_DEATH_BY_HARRIER_FEATHER"
msgstr "Pierced by the Sin Hawk's feather"

#. An enemy that doesn't say what it is.
msgid "UI_DEATH_BY_ENEMY"
msgstr "Killed by an enemy"

#. Something that doesn't say what it is.
msgid "UI_DEATH_BY_UNKNOWN"
msgstr "Struck down"

#. Items: their names, and what they do (shown in the inventory and when you get one).
msgid "UI_ITEM_DASH_BOOTS"
msgstr "Dash Boots"

msgid "UI_ITEM_DASH_BOOTS_DESC"
msgstr "Spring-loaded soles. Dash in any direction."

msgid "UI_ITEM_HEART_CONTAINER"
msgstr "Heart Container"

msgid "UI_ITEM_HEART_CONTAINER_DESC"
msgstr "One more heart of health."

msgid "UI_ITEM_CLIMBING_SPURS"
msgstr "Climbing Spurs"

msgid "UI_ITEM_CLIMBING_SPURS_DESC"
msgstr "Steel spikes that bite into walls. Jump off a wall you're sliding down."

msgid "UI_ITEM_STRONG_PIPE"
msgstr "Strong Pipe"

msgid "UI_ITEM_STRONG_PIPE_DESC"
msgstr "A heavier length of pipe. Every swing hits harder."

msgid "UI_ITEM_LEAD_CORE"
msgstr "Lead Core"

msgid "UI_ITEM_LEAD_CORE_DESC"
msgstr "A slug of lead to pack into your pipe. Every swing hits harder."

#. On screen, and in the dialogue box, when you get an item. {item}: its name.
msgid "UI_ITEM_RECEIVED"
msgstr "Received: {item}"

#. Pause menu: the button to the inventory, and the inventory page.
msgid "UI_PAUSE_INVENTORY"
msgstr "Inventory"

msgid "UI_INVENTORY_TITLE"
msgstr "INVENTORY"

#. The inventory with nothing in it.
msgid "UI_INVENTORY_EMPTY"
msgstr "Nothing yet."

#. An item you hold more than one of. {item}: its name; {count}: how many.
msgid "UI_INVENTORY_COUNT"
msgstr "{item} ×{count}"

#. The welcome card a new game opens with: its heading.
msgid "UI_INTRO_TITLE"
msgstr "Welcome to the Depot"

#. The welcome card: where you are and what to do. Friendly, two sentences.
msgid "UI_INTRO_BODY"
msgstr "The night shift never clocked out, and something has moved in below. Take your time, look around, and see how far down it goes."

#. The welcome card: the controls, keyboard then controller.
msgid "UI_INTRO_CONTROLS"
msgstr "Move: A / D or arrows   ·   Jump: Space   ·   Attack and talk: J   ·   Dash: K   ·   Pause: Esc\nController: stick or d-pad   ·   A   ·   X   ·   B   ·   Start"

#. The welcome card: how to close it.
msgid "UI_INTRO_CONTINUE"
msgstr "Press Attack or Jump to begin"

#. Main menu: carry on from your newest save.
#. Pause menu: the map of the rooms you've been in.
msgid "UI_PAUSE_MAP"
msgstr "Map"

#. The map page's heading.
msgid "UI_MAP_TITLE"
msgstr "MAP"

#. Main menu: carry on from your newest save.
msgid "UI_MENU_CONTINUE"
msgstr "Continue"

#. Main menu: pick a save to load.
msgid "UI_MENU_LOAD"
msgstr "Load"

#. New Game's list of campaigns: its heading.
msgid "UI_NEW_GAME_TITLE"
msgstr "NEW GAME"

#. New Game: a campaign with no saves. {n}: its number.
msgid "UI_CAMPAIGN_EMPTY"
msgstr "Campaign {n}: empty"

#. New Game: a campaign with saves. {n}: its number; {time}: play time, e.g. 0:12:03.
msgid "UI_CAMPAIGN_USED"
msgstr "Campaign {n}: {time} played"

#. New Game: a used campaign, after one press. Pressing again starts over, deleting its saves.
msgid "UI_CAMPAIGN_CONFIRM"
msgstr "Campaign {n}: press again to delete its saves and start over"

#. The Load list: its heading.
msgid "UI_LOAD_TITLE"
msgstr "LOAD"

#. The Load list, when there are no saves.
msgid "UI_LOAD_EMPTY"
msgstr "No saves yet. Rest at a bench to save."

#. On screen after resting at a bench, in a campaign: health refilled and the game saved.
msgid "UI_HUD_RESTED_SAVED"
msgstr "Rested. Game saved."

#. On screen after resting at a bench in a Test Room (nothing is saved there).
msgid "UI_HUD_RESTED"
msgstr "Rested."

#. On screen when resting at a bench couldn't save the game.
msgid "UI_HUD_SAVE_FAILED"
msgstr "Rested, but the game couldn't be saved."

#. A manual save's name in save lists. {n}: its number.
msgid "UI_SAVE_SLOT"
msgstr "Save {n}"

#. An autosave's name in save lists (benches save these). {n}: its number.
msgid "UI_SAVE_AUTOSAVE"
msgstr "Autosave {n}"

#. A debug save's name (debug builds only). {name}: its file name.
msgid "UI_SAVE_DEBUG"
msgstr "Debug: {name}"

#. A save in the Load list. {n}: campaign number; {slot}: the save's name; {time}: play time; {date}: when saved.
msgid "UI_SAVE_LINE"
msgstr "Campaign {n} · {slot} · {time} · {date}"

#. Loading a save that was broken, so its backup was used. {slot}: the save's name.
msgid "UI_SAVE_NOTE_BACKUP"
msgstr "{slot} was damaged; loaded its backup."

#. A save from a newer version of the game. {slot}: the save's name.
msgid "UI_SAVE_NOTE_NEWER"
msgstr "{slot} is from a newer version of the game."

#. A save from an older version of the game, which this one can't load. {slot}: the save's name.
msgid "UI_SAVE_NOTE_OLDER"
msgstr "{slot} is from an older version and can't be loaded."

#. A save made in a room the game no longer has. {slot}: the save's name.
msgid "UI_SAVE_NOTE_ROOM_GONE"
msgstr "{slot} was made in a room that's no longer in the game."

#. A save that couldn't be read at all.
msgid "UI_SAVE_UNREADABLE"
msgstr "That save couldn't be read."
